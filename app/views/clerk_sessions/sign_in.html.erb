<div class="d-flex flex-column min-vh-100 align-items-center justify-content-center login-wrapper"
     data-controller="clerk-auth"
     data-clerk-auth-sign-in-url-value="<%= new_user_session_path %>"
     data-clerk-auth-sign-up-url-value="<%= new_user_registration_path %>"
     data-clerk-auth-redirect-url-value="<%= games_path %>">
  <div class="card shadow-lg p-4 p-md-5 login-card">
    <div class="text-center mb-4">
      <h1 class="fw-bold mb-2 text-white">ログイン</h1>
      <p class="login-subtext">おかえりなさい！ゲームの記録を続けましょう</p>
    </div>
    <div data-clerk-auth-target="signIn"></div>
    <p class="text-danger mt-3 mb-0" data-clerk-auth-target="error" role="alert" hidden></p>
    <div class="text-center mt-4 pt-3 border-top login-footer-border">
      <span class="login-subtext">アカウントをお持ちでないですか？</span>
      <%= link_to "新規登録", new_user_registration_path, class: "fw-bold login-accent-link ms-1" %>
    </div>
  </div>
</div>
