<%= form_with model: game, local: true, html: { multipart: true }, class: "glass-panel position-relative", data: { controller: "game-form", game_form_search_url_value: search_games_path } do |f| %>
  <% if game.errors.any? %>
    <div class="alert alert-danger mb-3" style="background: rgba(239, 68, 68, 0.1); border-color: #ef4444; color: #fca5a5;">
      <strong>エラーが発生しました:</strong>
      <ul class="mb-0 mt-2">
        <% game.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="d-flex align-items-center mb-4 pb-3 form-heading">
    <span class="material-symbols-outlined me-3" style="font-size: 32px; color: var(--cyan-accent, #00e5ff);">
      <%= game.persisted? ? 'settings_suggest' : 'add_circle' %>
    </span>
    <h2 class="h4 mb-0 fw-bold text-white">
      <%= game.persisted? ? 'ステータス設定' : '新しいゲームを登録' %>
    </h2>
  </div>

  <div class="row g-4 mb-2">
    <div class="col-md-4">
      <div class="poster-uploader" data-action="click->game-form#triggerUpload">
        <button type="button" class="btn-clear-image" data-action="click->game-form#clearImage" title="画像をクリア" aria-label="画像をクリア">
          <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
        </button>
        <% if game.persisted? && game.image.attached? %>
          <%= image_tag game.image, class: "poster-preview", data: { game_form_target: "preview" } %>
        <% else %>
          <img src="" class="poster-preview d-none" data-game-form-target="preview">
        <% end %>
        <div class="text-center position-relative" style="z-index: 1;">
          <span class="material-symbols-outlined mb-2" style="font-size: 32px; color: #64748b;">image</span>
          <div class="poster-hint">画像をクリックして変更</div>
        </div>
      </div>
      <%= f.file_field :image, class: "d-none", accept: "image/*", data: { game_form_target: "file", action: "change->game-form#previewImage" } %>
      <%= hidden_field_tag :rawg_image_url, nil, data: { game_form_target: "imageUrl" } %>
    </div>

    <div class="col-md-8 d-flex flex-column justify-content-between">
      <div class="mb-3 title-search">
        <%= f.label :title, "タイトル", class: "modern-label" %>
        <%= f.text_field :title, class: "form-control modern-input title-input", placeholder: "ゲームタイトルを検索", autocomplete: "off", required: true, data: { game_form_target: "title", action: "input->game-form#search keydown->game-form#navigateSuggestions" } %>
        <div class="suggestion-list" data-game-form-target="suggestions" role="listbox" hidden></div>
        <div class="api-metadata" data-game-form-target="metadata" aria-live="polite" hidden>
          <span>RAWG</span>
          <span>メタスコア <strong data-game-form-target="metascoreLabel">--</strong></span>
          <span>平均プレイ時間 <strong data-game-form-target="playtimeLabel">--</strong></span>
        </div>
        <%= f.hidden_field :metascore, data: { game_form_target: "metascore" } %>
        <%= f.hidden_field :average_playtime, data: { game_form_target: "averagePlaytime" } %>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-sm-6">
          <%= f.label :platform, "プラットフォーム", class: "modern-label" %>
          <%= f.select :platform, ["Switch", "PS5", "PS4", "Xbox", "PC", "その他"], { include_blank: "選択してください" }, class: "form-select modern-input", data: { game_form_target: "platform" } %>
        </div>
        <div class="col-sm-6">
          <%= f.label :genre, "ジャンル", class: "modern-label" %>
          <%= f.select :genre, ["RPG", "アクション", "アドベンチャー", "シミュレーション", "スポーツ", "その他"], { include_blank: "選択してください" }, class: "form-select modern-input", data: { game_form_target: "genre" } %>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-sm-6">
          <%= f.label :purchased_at, "購入日", class: "modern-label" %>
          <%= f.date_field :purchased_at, class: "form-control modern-input" %>
        </div>
        <div class="col-sm-6">
          <label class="modern-label" for="game_play_time">プレイ時間</label>
          <div class="d-flex align-items-end">
            <%= f.number_field :play_time, class: "form-control modern-input me-2", placeholder: "0", min: 0, step: 1 %>
            <span class="input-unit">時間</span>
          </div>
        </div>
      </div>

      <div>
        <label class="modern-label">プレイ期間</label>
        <div class="d-flex align-items-center gap-2 play-period-fields">
          <%= f.date_field :started_at, class: "form-control modern-input" %>
          <span class="date-separator">〜</span>
          <%= f.date_field :finished_at, class: "form-control modern-input" %>
        </div>
      </div>

    </div>
  </div>

  <div class="row g-4 pt-3 mb-3 form-extras">
    <div class="col-sm-6">
      <label class="modern-label">ステータス <span class="text-info">*</span></label>
      <div class="segment-control">
        <%= f.radio_button :status, "未着手", id: "game_status_未着手" %>
        <label for="game_status_未着手">未着手</label>
        
        <%= f.radio_button :status, "プレイ中", id: "game_status_プレイ中" %>
        <label for="game_status_プレイ中">プレイ中</label>
        
        <%= f.radio_button :status, "クリア済", id: "game_status_クリア済" %>
        <label for="game_status_クリア済">クリア済</label>
      </div>
    </div>
    
    <div class="col-sm-6 d-flex flex-column justify-content-center">
      <label class="modern-label">評価</label>
      <%= f.hidden_field :rating, data: { game_form_target: "rating" } %>
      <div class="star-rating" data-action="mouseleave->game-form#resetStars" aria-label="ユーザー評価">
        <% 5.times do |i| %>
          <button type="button" class="material-symbols-outlined star-icon" data-value="<%= i + 1 %>" data-game-form-target="star" data-action="mouseenter->game-form#hoverStar click->game-form#clickStar" aria-label="<%= i + 1 %>つ星">star</button>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-2">
    <%= f.label :memo, "メモ", class: "modern-label" %>
    <%= f.text_area :memo, class: "form-control memo-textarea", rows: 3, placeholder: "感想や攻略メモ" %>
  </div>

  <div class="d-flex justify-content-end align-items-center gap-3 mt-4">
    <%= link_to "キャンセル", request.referer || games_path, class: "text-decoration-none", style: "color: #94a3b8; transition: color 0.2s;", onmouseover: "this.style.color='#f8fafc'", onmouseout: "this.style.color='#94a3b8'" %>
    <%= f.submit "保存する", class: "btn-submit-neon" %>
  </div>

<% end %>