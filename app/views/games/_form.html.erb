<%= form_with model: game, local: true, html: { multipart: true }, class: "game-form" do |f| %>
  <% if game.errors.any? %>
    <div class="alert alert-danger mb-4">
      <strong>エラーが発生しました:</strong>
      <% game.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <!-- 📷 ゲーム画像セクション（全幅） -->
  <div class="card bg-dark border-info mb-4">
    <div class="card-body">
      <div class="d-flex align-items-center mb-3">
        <h5 class="card-title text-info mb-0">📷 ゲーム画像</h5>
        <span class="badge bg-secondary ms-2">必須</span>
      </div>

      <!-- ドラッグ&ドロップエリア -->
      <div class="image-upload-zone mb-3" id="imageDropZone">
        <% if game.persisted? && game.image.attached? %>
          <!-- 既存画像表示 -->
          <div class="image-preview-container position-relative">
            <%= image_tag game.image, class: "img-fluid rounded", style: "max-height: 300px; object-fit: cover; width: 100%; display: block;" %>
            <div class="image-preview-overlay">
              <div class="overlay-buttons">
                <%= link_to "変更", "#", class: "btn btn-sm btn-info me-2", onclick: "document.getElementById('game_image').click(); return false;" %>
                <%= link_to "削除", destroy_image_game_path(game), method: :post, data: { confirm: "画像を削除してもよろしいですか？" }, class: "btn btn-sm btn-outline-danger" %>
              </div>
            </div>
          </div>
        <% else %>
          <!-- ドラッグ&ドロップ表示 -->
          <div class="upload-placeholder text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.7;">📁</div>
            <p class="text-light mb-2">画像をここにドラッグ&ドロップ</p>
            <p class="text-muted mb-3">または下のボタンをクリックして選択</p>
            <small class="text-muted d-block">JPG, PNG, GIF（最大10MB）</small>
          </div>
        <% end %>
      </div>

      <!-- ファイル選択フィールド（非表示） -->
      <%= f.file_field :image, class: "d-none", accept: "image/*", id: "imageFileInput" %>
      
      <!-- ファイル選択ボタン -->
      <button type="button" class="btn btn-outline-info w-100" onclick="document.getElementById('game_image').click();">
        画像を選択する
      </button>
    </div>
  </div>

  <!-- 📌 基本情報セクション -->
  <div class="card bg-dark border-secondary mb-4">
    <div class="card-body">
      <h5 class="card-title text-info mb-3">📌 基本情報</h5>
      
      <div class="mb-3">
        <%= f.label :title, "タイトル *", class: "form-label" %>
        <%= f.text_field :title, class: "form-control", placeholder: "ゲームのタイトルを入力" %>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :platform, "プラットフォーム *", class: "form-label" %>
            <%= f.select :platform, ["Switch", "PS5", "PS4", "Xbox", "PC", "その他"],
                { include_blank: "選択してください" }, class: "form-select" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :genre, "ジャンル *", class: "form-label" %>
            <%= f.select :genre, ["RPG", "アクション", "アドベンチャー", "シミュレーション", "スポーツ", "その他"],
                { include_blank: "選択してください" }, class: "form-select" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ⭐ 評価・ステータスセクション -->
  <div class="card bg-dark border-secondary mb-4">
    <div class="card-body">
      <h5 class="card-title text-info mb-3">⭐ 評価・ステータス</h5>
      
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :status, "ステータス *", class: "form-label" %>
            <%= f.select :status, ["未着手", "プレイ中", "クリア済"],
                { include_blank: "選択してください" }, class: "form-select" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :rating, "評価（1〜5）", class: "form-label" %>
            <div class="d-flex align-items-center">
              <%= f.select :rating, [1, 2, 3, 4, 5],
                  { include_blank: "未評価" }, class: "form-select" %>
              <span class="ms-2" id="ratingPreview">
                <% if game.rating %>
                  <% game.rating.times do %>
                    <span class="text-warning">⭐</span>
                  <% end %>
                  <% (5 - game.rating).times do %>
                    <span class="text-muted">☆</span>
                  <% end %>
                <% end %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 📝 詳細情報セクション -->
  <div class="card bg-dark border-secondary mb-4">
    <div class="card-body">
      <h5 class="card-title text-info mb-3">📝 詳細情報</h5>
      
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :purchased_at, "購入日", class: "form-label" %>
            <%= f.date_field :purchased_at, class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :memo, "メモ", class: "form-label" %>
        <%= f.text_area :memo, class: "form-control", rows: 4, placeholder: "ゲームについてのメモやコメントを入力..." %>
      </div>
    </div>
  </div>

  <!-- アクションボタン -->
  <div class="d-flex gap-2 mb-5">
    <%= f.submit "保存する", class: "btn btn-primary btn-lg" %>
    <%= link_to "キャンセル", games_path, class: "btn btn-outline-secondary btn-lg" %>
  </div>
<% end %>

<!-- ドラッグ&ドロップ及び評価プレビュー用スクリプト -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const dropZone = document.getElementById('imageDropZone');
  const fileInput = document.getElementById('game_image');
  const ratingSelect = document.querySelector('select[id$="_rating"]');

  // ドラッグ&ドロップ処理
  if (dropZone) {
    dropZone.addEventListener('dragover', function(e) {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });

    dropZone.addEventListener('dragleave', function(e) {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
    });

    dropZone.addEventListener('drop', function(e) {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        fileInput.files = files;
        // プレビュー表示（オプション）
        previewImage(files[0]);
      }
    });

    // クリック時もファイル選択ダイアログを開く
    dropZone.addEventListener('click', function(e) {
      if (!e.target.closest('.overlay-buttons')) {
        fileInput.click();
      }
    });
  }

  // ファイル選択時のプレビュー
  if (fileInput) {
    fileInput.addEventListener('change', function(e) {
      if (this.files.length > 0) {
        previewImage(this.files[0]);
      }
    });
  }

  // 評価変更時のプレビュー
  if (ratingSelect) {
    ratingSelect.addEventListener('change', function() {
      const rating = parseInt(this.value);
      const preview = document.getElementById('ratingPreview');
      
      if (isNaN(rating)) {
        preview.innerHTML = '';
      } else {
        let stars = '';
        for (let i = 0; i < rating; i++) {
          stars += '<span class="text-warning">⭐</span>';
        }
        for (let i = rating; i < 5; i++) {
          stars += '<span class="text-muted">☆</span>';
        }
        preview.innerHTML = stars;
      }
    });
  }

  function previewImage(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      const preview = document.querySelector('.image-preview-container') || 
                      document.querySelector('.upload-placeholder').parentElement;
      
      const html = `
        <div class="image-preview-container position-relative">
          <img src="${e.target.result}" class="img-fluid rounded" style="max-height: 300px; object-fit: cover; width: 100%; display: block;">
          <div class="image-preview-overlay">
            <div class="overlay-buttons">
              <button type="button" class="btn btn-sm btn-info me-2" onclick="document.getElementById('game_image').click(); return false;">変更</button>
            </div>
          </div>
        </div>
      `;
      
      const parent = document.querySelector('.image-upload-zone');
      const oldPreview = parent.querySelector('.image-preview-container');
      const oldPlaceholder = parent.querySelector('.upload-placeholder');
      
      if (oldPreview) oldPreview.remove();
      if (oldPlaceholder) oldPlaceholder.remove();
      
      parent.insertAdjacentHTML('afterbegin', html);
    };
    reader.readAsDataURL(file);
  }
});
</script>