<%= form_with model: game, local: true do |f| %>
  <% if game.errors.any? %>
    <div class="alert alert-danger">
      <% game.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, "タイトル", class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :image, "ゲーム画像", class: "form-label" %>
    <div class="mb-2">
      <% if game.image.attached? %>
        <%= image_tag game.image, class: "img-thumbnail", style: "max-width: 200px; height: auto;" %>
        <div class="mt-2">
          <%= f.submit "画像を変更", class: "btn btn-sm btn-outline-info me-2", onclick: "document.querySelector('input[type=\"file\"]').click(); return false;" %>
          <%= button_to "画像を削除", { action: :destroy_image }, method: :post, data: { confirm: "画像を削除してもよろしいですか？" }, class: "btn btn-sm btn-outline-danger", form_class: "d-inline" %>
        </div>
      <% end %>
    </div>
    <%= f.file_field :image, class: "form-control", accept: "image/*" %>
    <small class="form-text text-muted d-block mt-2">サポートされている形式: JPG, PNG, GIF（最大10MB）</small>
  </div>

  <div class="mb-3">
    <%= f.label :platform, "プラットフォーム", class: "form-label" %>
    <%= f.select :platform, ["Switch", "PS5", "PS4", "Xbox", "PC", "その他"],
        { include_blank: "選択してください" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :genre, "ジャンル", class: "form-label" %>
    <%= f.select :genre, ["RPG", "アクション", "アドベンチャー", "シミュレーション", "スポーツ", "その他"],
        { include_blank: "選択してください" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :status, "ステータス", class: "form-label" %>
    <%= f.select :status, ["未着手", "プレイ中", "クリア済"],
        { include_blank: "選択してください" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :rating, "評価（1〜5）", class: "form-label" %>
    <%= f.select :rating, [1, 2, 3, 4, 5],
        { include_blank: "未評価" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :memo, "メモ", class: "form-label" %>
    <%= f.text_area :memo, class: "form-control", rows: 3 %>
  </div>

  <div class="mb-3">
    <%= f.label :purchased_at, "購入日", class: "form-label" %>
    <%= f.date_field :purchased_at, class: "form-control" %>
  </div>

  <%= f.submit "保存する", class: "btn btn-primary" %>
  <%= link_to "キャンセル", games_path, class: "btn btn-outline-secondary ms-2" %>
<% end %>