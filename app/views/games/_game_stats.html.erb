<div class="card gaming-hud-panel" id="game-stats">
  <div class="card-body p-2 p-md-3">
    <div class="row text-center">
      <div class="col-6 col-md-3 stat-col border-end border-secondary border-opacity-25 mb-3 mb-md-0">
        <div class="mb-2 text-primary">
          <span class="material-symbols-outlined hud-icon">sports_esports</span>
        </div>
        <div class="stat-value text-white"><%= @total_count %></div>
        <div class="stat-label mt-1">全ゲーム</div>
      </div>
      
      <div class="col-6 col-md-3 stat-col border-md-end border-secondary border-opacity-25 mb-3 mb-md-0">
        <div class="mb-2 text-secondary">
          <span class="material-symbols-outlined hud-icon">layers</span>
        </div>
        <div class="stat-value text-white"><%= @unplayed_count %></div>
        <div class="stat-label mt-1">未着手</div>
      </div>

      <div class="col-6 col-md-3 stat-col border-end border-secondary border-opacity-25">
        <div class="mb-2 text-info">
          <span class="material-symbols-outlined hud-icon">play_circle</span>
        </div>
        <div class="stat-value text-white"><%= @playing_count %></div>
        <div class="stat-label mt-1">プレイ中</div>
      </div>

      <div class="col-6 col-md-3 stat-col">
        <div class="mb-2 text-success">
          <span class="material-symbols-outlined hud-icon">emoji_events</span>
        </div>
        <div class="stat-value text-white"><%= @cleared_count %></div>
        <div class="stat-label mt-1 mb-2">クリア済 (<%= @clear_rate %>%)</div>
        <div class="progress hud-progress">
          <div class="progress-bar bg-success glow-bar" style="width: <%= @clear_rate %>%"></div>
        </div>
      </div>
    </div>
  </div>
</div>
