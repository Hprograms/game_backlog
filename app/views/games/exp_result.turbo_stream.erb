<%= turbo_stream.replace "game-stats", partial: "games/game_stats" %>
<%= turbo_stream.replace "games-list", partial: "games/games_list" %>
<turbo-stream action="append" targets="body">
  <template>
    <%= render partial: "games/exp_result_modal",
      formats: [:html],
      locals: {
        game_title: @game.title,
        previous_level: @previous_level,
        previous_exp: @previous_exp,
        new_level: @new_level,
        new_exp: @new_exp,
        earned_exp_results: @game.earned_exp_results
      } %>
  </template>
</turbo-stream>
