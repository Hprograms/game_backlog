<div class="card gaming-hud-panel">
  <div class="card-body p-4">
    <div class="row text-center">
      <div class="col-4 stat-col border-end border-secondary border-opacity-25">
        <div class="mb-2 text-info">
          <i data-lucide="gamepad-2" class="hud-icon"></i>
        </div>
        <div class="stat-value text-white"><%= @total_count %></div>
        <div class="stat-label mt-1">Total Games</div>
      </div>
      
      <div class="col-4 stat-col border-end border-secondary border-opacity-25">
        <div class="mb-2 text-success">
          <i data-lucide="check-circle" class="hud-icon"></i>
        </div>
        <div class="stat-value text-white"><%= @games.where(status: "クリア済").count %></div>
        <div class="stat-label mt-1 mb-2">Cleared (<%= @clear_rate %>%)</div>
        <div class="progress hud-progress">
          <div class="progress-bar glow-bar" style="width: <%= @clear_rate %>%"></div>
        </div>
      </div>
      
      <div class="col-4 stat-col">
        <div class="mb-2 text-warning">
          <i data-lucide="trophy" class="hud-icon"></i>
        </div>
        <div class="stat-value text-white"><%= @games.where(status: "プレイ中").count %></div>
        <div class="stat-label mt-1">Playing</div>
      </div>
    </div>
  </div>
</div>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 controls-bar">
  <div class="btn-group filter-tabs" role="group">
    <%= link_to "全て", games_path, class: "btn #{params[:status].blank? ? 'active' : ''}" %>
    <%= link_to "未着手", games_path(status: "未着手"), class: "btn #{params[:status] == '未着手' ? 'active' : ''}" %>
    <%= link_to "プレイ中", games_path(status: "プレイ中"), class: "btn #{params[:status] == 'プレイ中' ? 'active' : ''}" %>
    <%= link_to "クリア済", games_path(status: "クリア済"), class: "btn #{params[:status] == 'クリア済' ? 'active' : ''}" %>
  </div>

  <%= link_to new_game_path, class: "btn-add-game" do %>
    <i data-lucide="plus"></i> 新規追加
  <% end %>
</div>

<% if @games.empty? %>
  <div class="card gaming-hud-panel text-center py-5">
    <div class="card-body">
      <div class="text-muted mb-3" style="opacity: 0.5;">
        <i data-lucide="package-open" style="width: 64px; height: 64px;"></i>
      </div>
      <p class="text-muted mb-4">まだゲームが登録されていません</p>
      <%= link_to "最初のゲームを追加する", new_game_path, class: "btn-add-game d-inline-flex" %>
    </div>
  </div>
<% else %>
  <div class="row g-3 g-md-4 mb-5">
    <% @games.each do |game| %>
      <div class="col-6 col-md-4 col-lg-3 col-xl-2">
        <div class="game-poster-card">
          <div class="poster-actions">
            <%= link_to edit_game_path(game), class: "action-btn", title: "編集" do %>
              <i data-lucide="edit-2"></i>
            <% end %>
            <%= link_to game_path(game), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "action-btn btn-delete", title: "削除" do %>
              <i data-lucide="trash-2"></i>
            <% end %>
          </div>

          <%= link_to game_path(game), class: "d-block h-100" do %>
            <% if game.image.attached? %>
              <%= image_tag game.image, class: "poster-image" %>
            <% else %>
              <div class="no-image-placeholder">
                <i data-lucide="image" style="width: 48px; height: 48px; opacity: 0.5; margin-bottom: 0.5rem;"></i>
                <small>No Image</small>
              </div>
            <% end %>

            <div class="poster-overlay">
              <div class="poster-title"><%= game.title %></div>
              
              <div class="poster-status">
                <div class="status-dot status-<%= game.status %>"></div>
                <%= game.status %>
              </div>

              <div class="poster-details">
                <div class="detail-item">
                  <i data-lucide="monitor"></i> <%= game.platform %>
                </div>
                <div class="detail-item">
                  <i data-lucide="star" style="color: #fbbf24;"></i> 
                  <%= game.rating ? "#{game.rating}.0" : "未評価" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>