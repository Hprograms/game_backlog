<%= render "game_stats" %>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 controls-bar">
  <div class="btn-group filter-tabs" role="group">
    <%= link_to "全て", games_path, class: "btn #{params[:status].blank? ? 'active' : ''}" %>
    <%= link_to "未着手", games_path(status: "未着手"), class: "btn #{params[:status] == '未着手' ? 'active' : ''}" %>
    <%= link_to "プレイ中", games_path(status: "プレイ中"), class: "btn #{params[:status] == 'プレイ中' ? 'active' : ''}" %>
    <%= link_to "クリア済", games_path(status: "クリア済"), class: "btn #{params[:status] == 'クリア済' ? 'active' : ''}" %>
  </div>

  <%= link_to new_game_path, class: "btn-add-game" do %>
    <span class="material-symbols-outlined" style="font-size: 20px;">add</span> 新規追加
  <% end %>
</div>

<%= render "games_list" %>