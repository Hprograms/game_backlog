<!-- Statistics Section -->
<div class="stats-container">
  <div class="stat-card">
    <div class="stat-icon">🎮</div>
    <h5>積みゲー総数</h5>
    <div class="number"><%= @total_count %></div>
    <span class="unit">本</span>
  </div>
  <div class="stat-card">
    <div class="stat-icon">✅</div>
    <h5>クリア済み</h5>
    <div class="number"><%= @games.where(status: "クリア済").count %></div>
    <span class="unit">本</span>
    <div class="progress-custom mt-2">
      <div class="progress-bar" style="width: <%= @clear_rate %>%"></div>
    </div>
    <small style="color: var(--secondary-text); margin-top: 0.5rem;">クリア率: <%= @clear_rate %>%</small>
  </div>
  <div class="stat-card">
    <div class="stat-icon">🏆</div>
    <h5>今月プレイ</h5>
    <div class="number"><%= @games.where(status: "プレイ中").count %></div>
    <span class="unit">本</span>
  </div>
</div>

<!-- Filter Section -->
<div class="filter-section">
  <%= link_to "全て", games_path, class: "filter-btn #{params[:status].blank? ? 'active' : ''}" %>
  <%= link_to "未着手", games_path(status: "未着手"), class: "filter-btn #{params[:status] == '未着手' ? 'active' : ''}" %>
  <%= link_to "プレイ中", games_path(status: "プレイ中"), class: "filter-btn #{params[:status] == 'プレイ中' ? 'active' : ''}" %>
  <%= link_to "クリア済", games_path(status: "クリア済"), class: "filter-btn #{params[:status] == 'クリア済' ? 'active' : ''}" %>
</div>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="section-title">マイゲームリスト</h1>
  <%= link_to "＋ ゲームを追加", new_game_path, class: "btn-add-game" %>
</div>

<% if @games.empty? %>
  <div class="empty-state">
    <div class="empty-state-icon">🎮</div>
    <p>まだゲームが登録されていません</p>
    <%= link_to "最初のゲームを追加する", new_game_path, class: "btn-add-game" %>
  </div>
<% else %>
  <!-- Games Grid -->
  <div class="games-grid">
    <% @games.each do |game| %>
      <div class="game-card">
        <!-- Card Image -->
        <div class="game-card-image">
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem; background: linear-gradient(135deg, rgba(0, 217, 255, 0.1), rgba(0, 153, 204, 0.1));">
            🎮
          </div>
          <div class="game-card-overlay">
            <%= link_to "詳細", game_path(game), style: "color: white; text-decoration: none; font-weight: 600;" %>
          </div>
        </div>

        <!-- Card Content -->
        <div class="game-card-content">
          <h3 class="game-card-title"><%= game.title %></h3>

          <!-- Meta Information -->
          <div class="game-card-meta">
            <div class="game-card-meta-item">
              <strong>🖥️ プラットフォーム:</strong> <%= game.platform %>
            </div>
            <div class="game-card-meta-item">
              <strong>🎯 ジャンル:</strong> <%= game.genre %>
            </div>
            <div class="game-card-meta-item">
              <strong>📅 購入:</strong> <%= game.purchased_at&.strftime('%Y年%m月%d日') || 'N/A' %>
            </div>
          </div>

          <!-- Status Badge -->
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <span class="status-badge <%= game.status %>"><%= game.status %></span>
          </div>

          <!-- Rating Stars -->
          <% if game.rating %>
            <div class="rating-display">
              <% game.rating.times do %>
                <span class="star">⭐</span>
              <% end %>
              <% (5 - game.rating).times do %>
                <span class="star empty">☆</span>
              <% end %>
            </div>
          <% else %>
            <div style="color: var(--secondary-text); font-size: 0.9rem; margin-bottom: 0.75rem;">未評価</div>
          <% end %>
        </div>

        <!-- Card Actions -->
        <div class="game-card-actions">
          <%= link_to "編集", edit_game_path(game), class: "card-action-btn" %>
          <%= link_to "削除", game_path(game), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "card-action-btn delete" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>