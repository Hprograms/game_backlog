<div class="row mb-4">
  <div class="col-md-4">
    <div class="card text-center">
      <div class="card-body">
        <h5 class="card-title">積みゲー総数</h5>
        <p class="card-text display-6"><%= @total_count %> 本</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-center">
      <div class="card-body">
        <h5 class="card-title">クリア済み</h5>
        <p class="card-text display-6"><%= @games.where(status: "クリア済").count %> 本</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-center">
      <div class="card-body">
        <h5 class="card-title">クリア率</h5>
        <p class="card-text display-6"><%= @clear_rate %> %</p>
      </div>
    </div>
  </div>
</div>

<div class="mb-3">
  <%= link_to "全て", games_path, class: "btn btn-outline-secondary me-1 #{params[:status].blank? ? 'active' : ''}" %>
  <%= link_to "未着手", games_path(status: "未着手"), class: "btn btn-outline-secondary me-1 #{params[:status] == '未着手' ? 'active' : ''}" %>
  <%= link_to "プレイ中", games_path(status: "プレイ中"), class: "btn btn-outline-primary me-1 #{params[:status] == 'プレイ中' ? 'active' : ''}" %>
  <%= link_to "クリア済", games_path(status: "クリア済"), class: "btn btn-outline-success me-1 #{params[:status] == 'クリア済' ? 'active' : ''}" %>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>マイゲームリスト</h1>
  <%= link_to "＋ ゲームを追加", new_game_path, class: "btn btn-primary" %>
</div>

<% if @games.empty? %>
  <div class="text-center text-muted py-5">
    <p>まだゲームが登録されていません</p>
    <%= link_to "最初のゲームを追加する", new_game_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <table class="table table-hover">
    <thead class="table-dark">
      <tr>
        <th>タイトル</th>
        <th>プラットフォーム</th>
        <th>ジャンル</th>
        <th>ステータス</th>
        <th>評価</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @games.each do |game| %>
        <tr>
          <td><%= link_to game.title, game_path(game) %></td>
          <td><%= game.platform %></td>
          <td><%= game.genre %></td>
          <td>
            <% badge_class = { "未着手" => "secondary", "プレイ中" => "primary", "クリア済" => "success" } %>
            <span class="badge bg-<%= badge_class[game.status] %>"><%= game.status %></span>
          </td>
          <td><%= game.rating ? "★" * game.rating : "-" %></td>
          <td>
            <%= link_to "編集", edit_game_path(game), class: "btn btn-sm btn-outline-secondary me-1" %>
            <%= link_to "削除", game_path(game), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>