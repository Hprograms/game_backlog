<article class="glass-panel game-show-panel">
  <div class="row g-4 g-lg-5 game-show-layout">
    <aside class="col-lg-4 game-show-visual">
      <div class="game-show-poster">
        <% if @game.image.attached? %>
          <%= image_tag @game.image, class: "game-show-poster__image", alt: "#{@game.title}のパッケージ画像" %>
        <% else %>
          <div class="game-show-placeholder">
            <span class="material-symbols-outlined" aria-hidden="true">sports_esports</span>
            <span>画像は未登録です</span>
          </div>
        <% end %>
      </div>

      <nav class="game-show-actions" aria-label="ゲーム操作">
        <%= link_to games_path, class: "game-show-action" do %>
          <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
          <span>一覧</span>
        <% end %>
        <%= link_to edit_game_path(@game), class: "game-show-action" do %>
          <span class="material-symbols-outlined" aria-hidden="true">edit</span>
          <span>編集</span>
        <% end %>
        <%= button_to game_path(@game), method: :delete, data: { turbo_confirm: "このゲームを削除しますか？" }, class: "game-show-action game-show-action--delete" do %>
          <span class="material-symbols-outlined" aria-hidden="true">delete</span>
          <span>削除</span>
        <% end %>
      </nav>
    </aside>

    <div class="col-lg-8 game-show-content">
      <header class="game-show-heading">
        <h1 class="game-show-title"><%= @game.title %></h1>
        <% if @game.developer.present? %>
          <p class="game-show-developer"><%= @game.developer %></p>
        <% end %>
      </header>

      <div class="game-show-tags" aria-label="ゲーム情報">
        <% if @game.platform.present? %>
          <span class="game-show-tag"><span class="material-symbols-outlined" aria-hidden="true">devices</span><%= @game.platform %></span>
        <% end %>
        <% if @game.genre.present? %>
          <span class="game-show-tag"><span class="material-symbols-outlined" aria-hidden="true">category</span><%= @game.genre %></span>
        <% end %>
        <% if @game.igdb_rating.present? %>
          <span class="game-show-tag game-show-tag--score"><span class="material-symbols-outlined" aria-hidden="true">analytics</span>IGDB Rating <strong><%= @game.igdb_rating %></strong></span>
        <% end %>
      </div>

      <% if @game.description.present? %>
        <section class="game-description-section" aria-labelledby="game-description-title">
          <h2 id="game-description-title" class="game-section-title">あらすじ</h2>
          <div class="game-description"><%= simple_format(@game.description) %></div>
        </section>
      <% end %>

      <section class="game-record" aria-labelledby="game-record-title">
        <h2 id="game-record-title" class="game-section-title">マイレコード</h2>
        <% status_style = case @game.status
        when "プレイ中" then "is-playing"
        when "クリア済" then "is-cleared"
        else "is-backlog"
        end %>

        <div class="game-record-grid">
          <div class="game-record-item">
            <span class="game-record-label">ステータス</span>
            <span class="game-record-status <%= status_style %>"><%= @game.status.presence || "未設定" %></span>
          </div>

          <div class="game-record-item">
            <span class="game-record-label">自分の評価</span>
            <div class="game-rating" role="img" aria-label="<%= @game.rating ? "#{@game.rating} / 5" : "未評価" %>">
              <% 5.times do |index| %>
                <span class="material-symbols-outlined <%= "is-active" if index < @game.rating.to_i %>" aria-hidden="true">star</span>
              <% end %>
              <% unless @game.rating.present? %><span class="game-rating-empty">未評価</span><% end %>
            </div>
          </div>

          <div class="game-record-item">
            <span class="game-record-label">購入日</span>
            <span class="game-record-value"><%= @game.purchased_at&.strftime("%Y.%m.%d") || "未記録" %></span>
          </div>

          <div class="game-record-item">
            <span class="game-record-label">プレイ期間</span>
            <span class="game-record-value game-play-period">
              <%= @game.started_at&.strftime("%Y.%m.%d") || "未記録" %>
              <span aria-hidden="true">〜</span>
              <%= @game.finished_at&.strftime("%Y.%m.%d") || "未記録" %>
            </span>
          </div>
        </div>

        <% if @game.memo.present? %>
          <div class="game-record-memo">
            <span class="game-record-label">メモ</span>
            <div class="game-memo"><%= simple_format(@game.memo) %></div>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</article>