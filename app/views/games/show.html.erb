<div class="card bg-dark border-secondary">
  <% if @game.image.attached? %>
    <%= image_tag @game.image, class: "card-img-top", style: "object-fit: cover; height: 300px; width: 100%;" %>
  <% else %>
    <div style="background: linear-gradient(135deg, rgba(0, 217, 255, 0.1), rgba(0, 153, 204, 0.1)); height: 300px; display: flex; align-items: center; justify-content: center; font-size: 5rem;">
      🎮
    </div>
  <% end %>
  
  <div class="card-body">
    <h1 class="card-title text-light"><%= @game.title %></h1>
    <table class="table mt-3 table-dark">
      <tr><th class="text-info">プラットフォーム</th><td class="text-light"><%= @game.platform %></td></tr>
      <tr><th class="text-info">ジャンル</th><td class="text-light"><%= @game.genre %></td></tr>
      <tr><th class="text-info">ステータス</th><td class="text-light"><%= @game.status %></td></tr>
      <tr><th class="text-info">評価</th><td class="text-light"><%= @game.rating ? "⭐" * @game.rating + "☆" * (5 - @game.rating) : "未評価" %></td></tr>
      <tr><th class="text-info">購入日</th><td class="text-light"><%= @game.purchased_at&.strftime('%Y年%m月%d日') || 'N/A' %></td></tr>
      <tr><th class="text-info">メモ</th><td class="text-light"><%= simple_format(@game.memo) %></td></tr>
    </table>
    <%= link_to "編集", edit_game_path(@game), class: "btn btn-info me-2" %>
    <%= link_to "削除", game_path(@game), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-outline-danger me-2" %>
    <%= link_to "一覧に戻る", games_path, class: "btn btn-outline-secondary" %>
  </div>
</div>