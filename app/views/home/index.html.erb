<div class="d-flex flex-column align-items-center mt-5"
     data-controller="clerk-auth"
     data-clerk-auth-sign-in-url-value="/"
     data-clerk-auth-sign-up-url-value="/?mode=signup"
     data-clerk-auth-redirect-url-value="<%= games_path %>">

  <div class="text-center mb-4 pb-2">
    <%= image_tag "TsumiQuest-logo2.png", alt: "ツミクエスト", style: "height: 180px; filter: drop-shadow(0 0 20px rgba(0, 229, 255, 0.4));" %>
  </div>

  <% if params[:mode] == 'signup' %>
    <div data-clerk-auth-target="signUp"></div>
  <% else %>
    <div data-clerk-auth-target="signIn"></div>
  <% end %>

  <p class="text-danger mt-3 mb-0" data-clerk-auth-target="error" role="alert" hidden></p>
</div>