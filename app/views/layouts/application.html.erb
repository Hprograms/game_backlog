<!DOCTYPE html>
<html>
  <head>
    <title>積みゲー管理</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom Application CSS (loaded AFTER Bootstrap to override) -->
    <%= stylesheet_link_tag "application", "login", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Dark Theme Override -->
    <style>
      :root {
        --navy-dark: #0a1428;
        --navy-medium: #1a2847;
        --navy-light: #2d4064;
        --cyan-accent: #00d9ff;
        --white-text: #f0f0f0;
        --secondary-text: #b0b0b0;
      }
      
      /* Critical: Override Bootstrap defaults FIRST */
      * {
        background-color: transparent !important;
      }
      
      html, body {
        background-color: var(--navy-dark) !important;
        color: var(--white-text) !important;
      }
      
      .container, .container-fluid {
        background-color: transparent !important;
      }
      
      p, span, li, td, th {
        color: var(--white-text) !important;
        background-color: transparent !important;
      }
      
      h1, h2, h3, h4, h5, h6, label {
        color: var(--white-text) !important;
        background-color: transparent !important;
      }
      
      /* Form Controls */
      .form-control,
      .form-select,
      input[type="text"],
      input[type="email"],
      input[type="password"],
      input[type="number"],
      input[type="date"],
      input[type="datetime-local"],
      textarea,
      select {
        background-color: var(--navy-medium) !important;
        color: var(--white-text) !important;
        border: 2px solid var(--navy-light) !important;
        border-radius: 0.375rem;
      }
      
      .form-control::placeholder,
      textarea::placeholder {
        color: var(--secondary-text) !important;
      }
      
      .form-control:focus,
      .form-select:focus,
      input:not([type="submit"]):focus,
      textarea:focus,
      select:focus {
        background-color: rgba(26, 40, 71, 0.8) !important;
        color: var(--white-text) !important;
        border-color: var(--cyan-accent) !important;
        box-shadow: 0 0 15px rgba(0, 217, 255, 0.3), inset 0 0 10px rgba(0, 217, 255, 0.05) !important;
      }
      
      select option {
        background-color: var(--navy-medium);
        color: var(--white-text);
      }
      
      .alert-success {
        background-color: rgba(0, 217, 255, 0.1) !important;
        border: 1px solid var(--cyan-accent) !important;
        color: var(--cyan-accent) !important;
      }
      
      .alert-danger {
        background-color: rgba(255, 68, 68, 0.1) !important;
        border: 1.5px solid #ff4444 !important;
        color: #ff6b6b !important;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand glow-effect" href="/">🎮 積みゲー管理</a>
        <div class="ms-auto">
          <% if user_signed_in? %>
            <span class="text-light me-3"><%= current_user.email %></span>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm d-inline" %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-light btn-sm me-2" %>
            <%= link_to "新規登録", new_user_registration_path, class: "btn btn-light btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
      <% if notice %>
        <div class="alert alert-success animate-in"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger animate-in"><%= alert %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>