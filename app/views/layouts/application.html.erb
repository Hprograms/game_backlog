<!DOCTYPE html>
<html data-controller="timer">
  <head>
    <title>ツミクエスト</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0" />
    
    <%= stylesheet_link_tag "application", "games", "game_card", "exp_result", "timer", "login", "trophies", "profiles", "activities", media: "all", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
    <% if Clerk.configuration.publishable_key.present? %>
      <% clerk_frontend_api = clerk_frontend_api_url %>
      <script defer crossorigin="anonymous" src="<%= clerk_frontend_api %>/npm/@clerk/ui@1/dist/ui.browser.js"></script>
      <script defer crossorigin="anonymous" data-clerk-publishable-key="<%= Clerk.configuration.publishable_key %>" src="<%= clerk_frontend_api %>/npm/@clerk/clerk-js@6/dist/clerk.browser.js"></script>
    <% end %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body>
    <div id="floating-timer" class="floating-timer" data-timer-target="floating" hidden>
      <div class="timer-warning text-danger fw-bold text-center mb-1" data-timer-target="warning" hidden>他のゲームを記録中です。</div>
      <div class="timer-content" data-timer-target="content">
        <div class="timer-info">
          <span class="material-symbols-outlined timer-icon">sports_esports</span>
          <span class="timer-game-title" data-timer-target="title">ゲーム名</span>
        </div>
        <div class="timer-display" data-timer-target="time">00:00:00</div>
        <button type="button" class="btn-stop-timer" data-action="click->timer#stop">
          <span class="material-symbols-outlined">stop</span>
          STOP
        </button>
      </div>
      <div class="timer-status-modal" data-timer-target="statusModal" role="dialog" aria-modal="true" hidden>
        <h3 class="timer-status-title">タイマーを停止しました</h3>
        <p class="timer-status-text">今回のプレイ時間: <strong data-timer-target="resultTime">0</strong> 分</p>

        <div class="mb-3 text-start">
          <div class="form-check d-flex align-items-center justify-content-center gap-2">
            <input class="form-check-input mt-0" type="checkbox" id="timer-clear-check" data-timer-target="clearCheck" data-action="change->timer#toggleClearWarning">
            <label class="form-check-label text-white fw-bold" for="timer-clear-check" style="cursor: pointer;">
              クエストクリア！（ゲームをクリアした）
            </label>
          </div>
          <p class="text-warning text-center mt-2 mb-0" style="font-size: 0.8rem;" data-timer-target="clearWarning" hidden>
            ※特大クリアボーナスを獲得します！<br>以降、未クリア状態に戻すことはできません。
          </p>
        </div>

        <div class="timer-status-actions d-flex flex-column gap-2">
          <button type="button" class="btn btn-primary w-100 fw-bold" data-timer-target="saveButton" data-action="click->timer#save">
            EXPを獲得する
          </button>
          <button type="button" class="btn btn-outline-secondary w-100" data-action="click->timer#cancel">
            計測を破棄する
          </button>
        </div>
        <p class="timer-status-error" data-timer-target="error" role="alert" hidden></p>
      </div>
    </div>
    <% unless controller_name == "home" %>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid px-4 px-xl-5">
          <a class="navbar-brand glow-effect d-flex align-items-center brand-title" href="/">
            <%= image_tag "TsumiQuest-logo.png", alt: "ロゴ", class: "brand-logo-image me-2" %>
            <span class="brand-title-text">ツミクエスト</span>
          </a>
          <div class="ms-auto">
            <% if clerk_authenticated? %>
              <div data-controller="clerk-auth" class="d-flex align-items-center gap-3">
                <%= link_to trophies_path, class: "btn btn-outline-light btn-sm d-inline-flex align-items-center gap-1" do %>
                  <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
                  <span>トロフィー</span>
                <% end %>
                <%= link_to activities_path, class: "btn btn-outline-light btn-sm d-inline-flex align-items-center gap-1" do %>
                  <span class="material-symbols-outlined" aria-hidden="true">history</span>
                  <span>冒険の書</span>
                <% end %>
                <div class="user-profile-widget d-flex flex-column align-items-center">
                  <div data-clerk-auth-target="userButton"></div>
                  <% if current_user %>
                    <% progress = level_progress(current_user) %>
                    <div class="header-level-container mt-1" title="<%= progress[:current_exp] %> / <%= progress[:required_exp] %> EXP">
                      <div class="d-flex justify-content-between align-items-center" style="font-size: 0.65rem; line-height: 1;">
                        <span class="text-white fw-bold">Lv.<%= current_user.level %></span>
                      </div>
                      <div class="header-progress-track mt-1">
                        <div class="header-progress-fill" style="width: <%= progress[:percentage] %>%"></div>
                      </div>
                    </div>
                  <% end %>
                </div>
                <span class="text-danger" data-clerk-auth-target="error" role="alert" hidden></span>
              </div>
            <% end %>
          </div>
        </div>
      </nav>
    <% end %>

    <div class="container-fluid px-4 px-xl-5 main-container">
      <% if notice %>
        <div class="alert alert-success animate-in"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger animate-in"><%= alert %></div>
      <% end %>
      <%= yield %>
    </div>
    <% if session[:exp_result_data].present? %>
      <% exp_data = session.delete(:exp_result_data).deep_symbolize_keys %>
      <%= render partial: "games/exp_result_modal",
                 locals: {
                   game_title: exp_data[:game_title],
                   previous_level: exp_data[:previous_level],
                   previous_exp: exp_data[:previous_exp],
                   new_level: exp_data[:new_level],
                   new_exp: exp_data[:new_exp],
                   earned_exp_results: exp_data[:results]
                 } %>
    <% end %>
  </body>
</html>