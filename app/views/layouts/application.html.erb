<!DOCTYPE html>
<html>
  <head>
    <title>積みゲー管理</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Custom Application CSS (loaded AFTER Bootstrap to override) -->
    <%= stylesheet_link_tag "application", "games", "login", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand glow-effect" href="/">🎮 積みゲー管理</a>
        <div class="ms-auto">
          <% if user_signed_in? %>
            <span class="text-light me-3"><%= current_user.email %></span>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm d-inline" %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-light btn-sm me-2" %>
            <%= link_to "新規登録", new_user_registration_path, class: "btn btn-light btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
      <% if notice %>
        <div class="alert alert-success animate-in"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger animate-in"><%= alert %></div>
      <% end %>
      <%= yield %>
    </div>
    <script>
      document.addEventListener("turbo:load", () => {
        lucide.createIcons();
      });
    </script>
  </body>
</html>