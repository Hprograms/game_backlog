<!DOCTYPE html>
<html>
  <head>
    <title>積みゲー管理</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">🎮 積みゲー管理</a>
        <div class="ms-auto">
          <% if user_signed_in? %>
            <span class="text-light me-3"><%= current_user.email %></span>
            <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-light btn-sm" %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-light btn-sm me-2" %>
            <%= link_to "新規登録", new_user_registration_path, class: "btn btn-light btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>